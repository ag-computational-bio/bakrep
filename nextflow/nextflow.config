manifest {
    author = 'Linda Fenske'
    name = 'BakRep v2.0'
    homePage = 'https://github.com/ag-computational-bio/bakrep'
    description = 'A workflow for taxonomic classification, subtyping and annotation of the assemblies generated by AllTheBacteria.'
    mainScript = 'BakRep.nf'
    version = '2.0.0'
}

params {
/*
	Defines some default parameters. These can be adjusted via the command line when runnig the pipeline.
	The default executor is 'local'. To use the slurm cluster add the parameter '-profile slurm'.
*/
    db = "${params.setupdir}/database"
    gtdb = "${db}/gtdb/release232"
    checkm2db = "${db}/checkm2db/CheckM2_database/uniref100.KO.1.dmnd"
    baktadb = "${db}/baktadb/db"
    amrdb = "${baktadb}/amrfinderplus-db/latest"
    data = "${params.setupdir}/assemblies"
    results = "${params.setupdir}/results"
}	

/*
	Defines profiles for local execution or execution via the slurm-cluster.
*/

profiles {
    standard {
		process.executor = 'local'
		params.threads = Runtime.runtime.availableProcessors()
	        stageOutMode = 'rsync'
    }
    
    cluster {
		process.executor = 'slurm'
		process.queue = 'compute'
    }

/*
	Rerun of samples whose taxonomy failed with OOM at 100 GB (pplacer memory grows with the number of threads).
	Use together with the cluster profile and a sample list of only these samples: -profile cluster,heavy_taxonomy
	pplacer with 1 thread, 150 GB (2nd attempt 220 GB, fits a medium node), then ignore.
*/
    heavy_taxonomy {
		process {
			withName: 'taxonomy' {
				cpus          = 1
				memory        = { task.attempt == 1 ? 150.GB : 220.GB }
				errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
				maxRetries    = 1
			}
		}
    }
}

process {
	queue = 'compute'
	scratch = '/scratch'
	beforeScript = 'export TMPDIR=$NXF_SCRATCH'
	stageOutMode = 'rsync'
//	withName: 'qualityCheck|assemblyScan|mlst|amr|taxonomy|annotation' {
//		array = 200
//    }
}

executor {
	name = 'slurm'
	queueSize = 5000
	pollInterval = '30 sec'
	queueStatInterval = '2 min'
	submitRateLimit   = '10/1sec'
	exitReadTimeout = '90 min'

}

conda {
	enabled = true
	createTimeout = '4 h'
	cacheDir = '/shared/conda-envs'
}

report {
    enabled = true
    overwrite = true
	file = 'Bakrep_nf.report.html'
}

timeline {
    enabled = false
    overwrite = true
}

trace {
    enabled = false
    overwrite = true
}

dag {
	enabled = true
	overwrite = true
	file = 'Bakrep_nf.dag.png'
}	
